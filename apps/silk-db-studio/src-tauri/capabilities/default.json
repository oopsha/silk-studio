{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-outer-size",
    "core:window:allow-outer-position",
    "core:window:allow-inner-size",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-is-maximized",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-scale-factor",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-watch",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-unwatch",
      "allow": [{ "path": "**" }]
    },
    "window-controls:default",
    "allow-ensure-title-bar-overlay",
    "allow-query-execute",
    "allow-connection-commands",
    "allow-secret-commands",
    "allow-ai-http-commands",
    "allow-window-layout-commands",
    "allow-app-log-commands",
    "updater:default",
    "process:default"
  ]
}