{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Silk DB Studio",
  "version": "0.1.3",
  "identifier": "com.oopsha.silk-db-studio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && node ../../scripts/prepare-runtime-resources.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Silk DB Studio",
        "width": 800,
        "height": 600,
        "visible": false,
        "decorations": false,
        "dragDropEnabled": true,
        "backgroundColor": "#191a1b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/jdbc-agent",
      "resources/jre",
      "resources/ssm-plugin"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxQTVCOTQzMjZGMzY4OEEKUldTS2FQTW1RN21sZ2ZydXltc01NdytyTmJQejdSUERJdllDMHFHWGpQaTFtOXBEUFE5T2x2Qm8K",
      "endpoints": [
        "https://github.com/oopsha/silk-studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
