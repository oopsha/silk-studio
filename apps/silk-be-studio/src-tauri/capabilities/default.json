{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability for the Silk BE Studio main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:default",
    "fs:default",
    { "identifier": "fs:allow-read-dir", "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-read-text-file", "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-write-text-file", "allow": [{ "path": "**" }] },
    "window-controls:default",
    "allow-ensure-title-bar-overlay",
    "allow-ai-http-commands",
    "allow-startup-theme-commands",
    "allow-window-layout-commands"
  ]
}
