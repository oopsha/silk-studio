{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Silk Zip",
  "version": "0.1.0",
  "identifier": "com.oopsha.silk-zip",
  "build": { "beforeDevCommand": "pnpm dev", "devUrl": "http://localhost:1424", "beforeBuildCommand": "pnpm build", "frontendDist": "../dist" },
