# Copy to .env.local or export in CI — never commit real values.
# See docs/release.md

# Required for updater artifact signatures
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Optional macOS code sign + notarize
APPLE_CERTIFICATE=
APPLE_CERTIFICATE_PASSWORD=
APPLE_SIGNING_IDENTITY=
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=

# Optional Windows Authenticode
WINDOWS_CERTIFICATE=
WINDOWS_CERTIFICATE_PASSWORD=
