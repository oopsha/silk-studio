{
  "name": "silk-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "pnpm --filter @silk-studio/db-studio exec tsc --noEmit",
    "build:web": "pnpm --filter @silk-studio/db-studio build",
    "build:agent": "cd packages/jdbc-agent && ./gradlew build --quiet"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@9.15.0"
}
